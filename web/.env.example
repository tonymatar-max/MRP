# Base URL of the Cobalt MRP .NET Web API
VITE_API_BASE=/api

# When true, the UI serves realistic sample data from src/mocks (no backend needed).
# Set to false to call the real API at VITE_API_BASE.
VITE_USE_MOCK=true

# Dev-only: where vite proxies /api when VITE_USE_MOCK=false
# VITE_API_PROXY=http://localhost:5050
